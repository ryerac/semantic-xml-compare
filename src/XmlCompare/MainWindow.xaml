<Window x:Class="XmlCompare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XmlCompare"
        xmlns:model="clr-namespace:XmlCompare.Models"
        Title="XML Compare" Width="1500" Height="900" MinWidth="1000" MinHeight="600"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextBrush}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C8D0DC" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF" />
                    <Setter Property="BorderBrush" Value="#93B4F5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,9" />
            <Setter Property="MinWidth" Value="120" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                    <Setter Property="BorderBrush" Value="#1D4ED8" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type model:CompareNode}" ItemsSource="{Binding Children}">
            <Border Padding="3,2" ToolTip="{Binding ToolTipText}" CornerRadius="4" BorderThickness="1" Margin="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{Binding RowBrush}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                <Setter Property="Background" Value="#DBEAFE" />
                                <Setter Property="BorderBrush" Value="#60A5FA" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                <Setter Property="BorderBrush" Value="#BFDBFE" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Width="Auto">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" SharedSizeGroup="NodeName" />
                        <ColumnDefinition Width="*" SharedSizeGroup="FileOne" />
                        <ColumnDefinition Width="*" SharedSizeGroup="FileTwo" />
                        <ColumnDefinition Width="*" SharedSizeGroup="FileThree" />
                        <ColumnDefinition Width="170" SharedSizeGroup="Status" />
                        <ColumnDefinition Width="176" SharedSizeGroup="TreeActions" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="4,2,10,2" />
                    <TextBlock Grid.Column="1" Text="{Binding Value1}" TextTrimming="CharacterEllipsis" Margin="6,2" />
                    <TextBlock Grid.Column="2" Text="{Binding Value2}" TextTrimming="CharacterEllipsis" Margin="6,2" />
                    <TextBlock Grid.Column="3" Text="{Binding Value3}" TextTrimming="CharacterEllipsis" Margin="6,2" />
                    <Border Grid.Column="4" Background="{Binding StatusBackground}" CornerRadius="9" HorizontalAlignment="Left" Padding="8,2" Margin="5,1">
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>
        </HierarchicalDataTemplate>
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="XML Compare" FontSize="25" FontWeight="Bold" />
                <TextBlock Text="Semantic, order-independent XML comparison" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Compare files" Click="Compare_Click" Margin="12,2,0,2" />
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Click="File1_Click" HorizontalContentAlignment="Left" Padding="12,9" Margin="0">
                        <StackPanel><TextBlock Text="FILE 1" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding FileLabels[0]}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel>
                    </Button>
                    <Button Grid.Column="1" Content="×" Click="ClearFile1_Click" ToolTip="Clear file 1" FontSize="18" Width="38" Padding="0" Margin="6,0,0,0" />
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Click="File2_Click" HorizontalContentAlignment="Left" Padding="12,9" Margin="0">
                        <StackPanel><TextBlock Text="FILE 2" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding FileLabels[1]}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel>
                    </Button>
                    <Button Grid.Column="1" Content="×" Click="ClearFile2_Click" ToolTip="Clear file 2" FontSize="18" Width="38" Padding="0" Margin="6,0,0,0" />
                </Grid>
                <Grid Grid.Column="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Click="File3_Click" HorizontalContentAlignment="Left" Padding="12,9" Margin="0">
                        <StackPanel><TextBlock Text="FILE 3 · OPTIONAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding FileLabels[2]}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel>
                    </Button>
                    <Button Grid.Column="1" Content="×" Click="ClearFile3_Click" ToolTip="Clear file 3" FontSize="18" Width="38" Padding="0" Margin="6,0,0,0" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="11,8">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="&#x2190; Previous" Click="Previous_Click" IsEnabled="{Binding HasDifferences}" ToolTip="Select the previous changed or missing node" Margin="0,0,5,0" />
                            <Button Content="Next &#x2192;" Click="Next_Click" IsEnabled="{Binding HasDifferences}" ToolTip="Select the next changed or missing node" Margin="0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="RESULT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding DifferenceSummary}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="COMPARISON" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="ProfileBox" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" SelectionChanged="ProfileBox_SelectionChanged" Width="150" Margin="0,0,20,0" Padding="6,4" />
                    <TextBlock Text="Fixed tolerance" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Maximum fixed numeric difference. For example, 0.01 treats 10.000 and 10.005 as equal." />
                    <TextBox x:Name="AbsoluteToleranceBox" Text="{Binding AbsoluteTolerance, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,18,0" LostKeyboardFocus="Tolerance_LostKeyboardFocus" ToolTip="Fixed numeric difference allowed. Example: 0.01 allows values to differ by up to 0.01." />
                    <TextBlock Text="Relative tolerance" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Allowed proportional difference. Enter a ratio: 0.001 means 0.1%, and 0.01 means 1%." />
                    <TextBox x:Name="RelativeToleranceBox" Text="{Binding RelativeTolerance, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,18,0" LostKeyboardFocus="Tolerance_LostKeyboardFocus" ToolTip="Proportional difference allowed. Enter 0.001 for 0.1%, or 0.01 for 1%." />
                    <CheckBox x:Name="DifferencesOnlyBox" Content="Show differences only" IsChecked="True" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed" />
                </StackPanel>
                <Grid Grid.Row="2" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="FIND" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" x:Name="SearchBox" ToolTip="Filter the tree by node name, XML path, or value" TextChanged="SearchBox_TextChanged" />
                </Grid>
                <TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11"
                           Text="Fixed: 0.01 = within one penny    •    Relative: 0.001 = 0.1%    •    A value is equal when either tolerance passes" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="0">
            <Grid Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="#E9EEF5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" SharedSizeGroup="NodeName" />
                        <ColumnDefinition Width="*" SharedSizeGroup="FileOne" />
                        <ColumnDefinition Width="*" SharedSizeGroup="FileTwo" />
                        <ColumnDefinition Width="*" SharedSizeGroup="FileThree" />
                        <ColumnDefinition Width="170" SharedSizeGroup="Status" />
                        <ColumnDefinition Width="176" SharedSizeGroup="TreeActions" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Node" FontWeight="Bold" Margin="10" />
                    <TextBlock Grid.Column="1" Text="{Binding ShortFileLabels[0]}" FontWeight="Bold" Margin="6,10" />
                    <TextBlock Grid.Column="2" Text="{Binding ShortFileLabels[1]}" FontWeight="Bold" Margin="6,10" />
                    <TextBlock Grid.Column="3" Text="{Binding ShortFileLabels[2]}" FontWeight="Bold" Margin="6,10" />
                    <TextBlock Grid.Column="4" Text="Status" FontWeight="Bold" Margin="6,10" />
                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Content="Expand all" Click="ExpandAll_Click" ToolTip="Expand all currently visible branches" Padding="10,4" MinHeight="28" Margin="0,0,4,0" />
                        <Button Content="Collapse all" Click="CollapseAll_Click" ToolTip="Collapse the entire comparison tree" Padding="10,4" MinHeight="28" Margin="0" />
                    </StackPanel>
                </Grid>
                <TreeView x:Name="ComparisonTree" Grid.Row="1" ItemsSource="{Binding Roots}" BorderThickness="0" Padding="6" Background="#FBFCFE" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#172033" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#172033" />
                    </TreeView.Resources>
                </TreeView>
                <TextBlock x:Name="EmptyMessage" Grid.Row="1" Text="Drop 2–3 XML files here, or choose files above." Foreground="{StaticResource MutedBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" Margin="3,9,0,0" />
    </Grid>
</Window>
