<Window x:Class="XmlCompare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XmlCompare"
        xmlns:model="clr-namespace:XmlCompare.Models"
        Title="XML Compare" Width="1500" Height="900" MinWidth="1000" MinHeight="600"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextBrush}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C8D0DC" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF" />
                    <Setter Property="BorderBrush" Value="#93B4F5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,9" />
            <Setter Property="MinWidth" Value="120" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                    <Setter Property="BorderBrush" Value="#1D4ED8" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type model:CompareNode}" ItemsSource="{Binding Children}">
            <Border Padding="3,2" ToolTip="{Binding ToolTipText}" CornerRadius="4" BorderThickness="1" Margin="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{Binding RowBrush}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                <Setter Property="Background" Value="#DBEAFE" />
                                <Setter Property="BorderBrush" Value="#60A5FA" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                <Setter Property="BorderBrush" Value="#BFDBFE" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Width="Auto">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" SharedSizeGroup="NodeName" />
                        <ColumnDefinition Width="*" SharedSizeGroup="FileOne" />
                        <ColumnDefinition Width="*" SharedSizeGroup="FileTwo" />
                        <ColumnDefinition Width="*" SharedSizeGroup="FileThree" />
                        <ColumnDefinition Width="170" SharedSizeGroup="Status" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="4,2,10,2" />
                    <TextBlock Grid.Column="1" Text="{Binding Value1}" TextTrimming="CharacterEllipsis" Margin="6,2" />
                    <TextBlock Grid.Column="2" Text="{Binding Value2}" TextTrimming="CharacterEllipsis" Margin="6,2" />
                    <TextBlock Grid.Column="3" Text="{Binding Value3}" TextTrimming="CharacterEllipsis" Margin="6,2" />
                    <Border Grid.Column="4" Background="{Binding StatusBackground}" CornerRadius="9" HorizontalAlignment="Left" Padding="8,2" Margin="5,1">
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>
        </HierarchicalDataTemplate>
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="XML Compare" FontSize="25" FontWeight="Bold" />
                <TextBlock Text="Semantic, order-independent XML comparison" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Compare files" Click="Compare_Click" Margin="12,2,0,2" />
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="File1_Click" HorizontalContentAlignment="Left" Padding="12,9">
                    <StackPanel><TextBlock Text="FILE 1" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding FileLabels[0]}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Grid.Column="2" Click="File2_Click" HorizontalContentAlignment="Left" Padding="12,9">
                    <StackPanel><TextBlock Text="FILE 2" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding FileLabels[1]}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Grid.Column="4" Click="File3_Click" HorizontalContentAlignment="Left" Margin="0" Padding="12,9">
                    <StackPanel><TextBlock Text="FILE 3 · OPTIONAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding FileLabels[2]}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="ProfileBox" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Width="150" Margin="0,0,14,0" Padding="6,4" />
                <TextBlock Text="Absolute tolerance" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="AbsoluteToleranceBox" Text="{Binding AbsoluteTolerance}" Width="100" Margin="0,0,14,0" />
                <TextBlock Text="Relative tolerance" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="RelativeToleranceBox" Text="{Binding RelativeTolerance}" Width="100" Margin="0,0,14,0" />
                <CheckBox x:Name="DifferencesOnlyBox" Content="Differences only" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" Checked="Filter_Changed" Unchecked="Filter_Changed" />
                <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="SearchBox" Width="190" ToolTip="Search names, paths and values" TextChanged="SearchBox_TextChanged" />
                <Button Content="Previous" Click="Previous_Click" Margin="8,0,4,0" />
                <Button Content="Next" Click="Next_Click" Margin="0" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="0">
            <Grid Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="#E9EEF5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" SharedSizeGroup="NodeName" />
                        <ColumnDefinition Width="*" SharedSizeGroup="FileOne" />
                        <ColumnDefinition Width="*" SharedSizeGroup="FileTwo" />
                        <ColumnDefinition Width="*" SharedSizeGroup="FileThree" />
                        <ColumnDefinition Width="170" SharedSizeGroup="Status" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Node" FontWeight="Bold" Margin="10" />
                    <TextBlock Grid.Column="1" Text="{Binding ShortFileLabels[0]}" FontWeight="Bold" Margin="6,10" />
                    <TextBlock Grid.Column="2" Text="{Binding ShortFileLabels[1]}" FontWeight="Bold" Margin="6,10" />
                    <TextBlock Grid.Column="3" Text="{Binding ShortFileLabels[2]}" FontWeight="Bold" Margin="6,10" />
                    <TextBlock Grid.Column="4" Text="Status" FontWeight="Bold" Margin="6,10" />
                </Grid>
                <TreeView x:Name="ComparisonTree" Grid.Row="1" ItemsSource="{Binding Roots}" BorderThickness="0" Padding="6" Background="#FBFCFE" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#172033" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#172033" />
                    </TreeView.Resources>
                </TreeView>
                <TextBlock x:Name="EmptyMessage" Grid.Row="1" Text="Drop 2–3 XML files here, or choose files above." Foreground="{StaticResource MutedBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" Margin="3,9,0,0" />
    </Grid>
</Window>
